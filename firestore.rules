rules_version = '2';

// Regras do projeto Firebase do Dgust Açaí.
// Como usar: Firebase Console > Firestore Database > Regras > cole tudo > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // ADMIN: mexe no painel o RESPONSÁVEL (e-mail fixo abaixo) e as contas que ele autorizou
    // na aba "Acessos" do painel (ficam na coleção admins, uma por conta).
    // Se trocar o e-mail do responsável aqui, troque também em src/lib/access.ts.
    // ---------------------------------------------------------------
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email in ['lv6696184@gmail.com'];
    }

    function isApprovedAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSuperAdmin() || isApprovedAdmin();
    }

    // ---------------------------------------------------------------
    // Contas autorizadas: a própria pessoa lê o seu documento (pra saber se já foi liberada),
    // o responsável lê todos. SÓ o responsável cria, altera ou apaga.
    // ---------------------------------------------------------------
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['email', 'name', 'approvedAt'])
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // Pedidos de acesso: quem criou conta pede o próprio acesso, mas só com o e-mail
    // CONFIRMADO (assim ninguém se passa por outra pessoa) e sempre como "pending".
    // Só o responsável autoriza, nega ou apaga. Cada pessoa lê só o próprio pedido.
    // ---------------------------------------------------------------
    match /accessRequests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if (
          request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email_verified == true
          && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'createdAt'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
        ) || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------
    // Cardápio (menuStatus): qualquer visitante LÊ só os documentos abaixo
    // (o site precisa saber o que está esgotado, o preço, se está pausado).
    // Só o admin ESCREVE.
    // ---------------------------------------------------------------
    match /menuStatus/{docId} {
      allow read: if docId in [
        'soldOut', 'hiddenItems', 'priceOverrides', 'nameOverrides',
        'descriptionOverrides', 'emergencyPause', 'manualOpen'
      ];
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Fotos trocadas pelo painel (uma por produto, JPEG já reduzido no navegador).
    // Qualquer visitante LÊ (o site mostra a foto); só o admin grava/apaga, e o texto
    // da imagem tem limite de tamanho (o documento do Firestore aceita no máximo ~1 MB).
    // ---------------------------------------------------------------
    match /menuPhotos/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() < 500000;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Combo do dia: qualquer visitante LÊ (o site mostra os combos que valem hoje);
    // só o admin cria, altera e apaga, e o combo precisa ter dados válidos.
    // ---------------------------------------------------------------
    match /dailyCombos/{comboId} {
      allow read: if true;
      allow create, update: if isAdmin() && validCombo(request.resource.data);
      allow delete: if isAdmin();
    }

    function validCombo(d) {
      return d.keys().hasOnly(['name', 'description', 'price', 'image', 'days', 'createdAt'])
        && d.keys().hasAll(['name', 'description', 'price', 'image', 'days', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 300
        && d.price is number && d.price > 0 && d.price <= 999
        && d.image is string && d.image.size() < 500000
        && d.days is list && d.days.size() >= 1 && d.days.size() <= 7
        && d.createdAt is timestamp;
    }

    // ---------------------------------------------------------------
    // Itens novos criados pelo painel (Cardápio > Adicionar item novo): qualquer visitante
    // LÊ (aparecem no cardápio); só o admin cria, altera e apaga, com dados válidos.
    // ---------------------------------------------------------------
    match /customMenuItems/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validCustomItem(request.resource.data);
      allow delete: if isAdmin();
    }

    function validCustomItem(d) {
      return d.keys().hasOnly(['category', 'name', 'description', 'price', 'image', 'createdAt'])
        && d.keys().hasAll(['category', 'name', 'description', 'price', 'image', 'createdAt'])
        && d.category in ['premium', 'garrafa', 'barca_marmita', 'sobremesa']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 300
        && d.price is number && d.price > 0 && d.price <= 999
        && d.image is string && d.image.size() < 500000
        && d.createdAt is timestamp;
    }

    // ---------------------------------------------------------------
    // Taxa de entrega por bairro: qualquer visitante LÊ (o checkout mostra a lista);
    // só o admin cria, altera e apaga, com dados válidos.
    // ---------------------------------------------------------------
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow create, update: if isAdmin() && validZone(request.resource.data);
      allow delete: if isAdmin();
    }

    function validZone(d) {
      return d.keys().hasOnly(['name', 'fee'])
        && d.keys().hasAll(['name', 'fee'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.fee is number && d.fee >= 0 && d.fee <= 999;
    }

    // ---------------------------------------------------------------
    // Contador do número do pedido. O site precisa LER e AVANÇAR em 1 dentro
    // da transação que grava o pedido; volta pro 1 depois do 100.
    // ---------------------------------------------------------------
    match /counters/orders {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['current'])
        && request.resource.data.current == 1;
      allow update: if request.resource.data.keys().hasOnly(['current'])
        && request.resource.data.current is int
        && (
          request.resource.data.current == resource.data.current + 1
          || (resource.data.current >= 100 && request.resource.data.current == 1)
        )
        && request.resource.data.current <= 100;
    }

    // ---------------------------------------------------------------
    // Pedidos: qualquer visitante CRIA um pedido válido (o cliente do site não
    // tem login) mas ninguém além do admin LÊ, altera ou apaga.
    // ---------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if validOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    function validOrder(d) {
      return d.keys().hasOnly([
          'customerName', 'customerPhone', 'items', 'subtotal', 'deliveryFee', 'total',
          'deliveryType', 'location', 'paymentMethod', 'changeFor', 'notes',
          'orderNumber', 'createdAt'
        ])
        && d.keys().hasAll([
          'customerName', 'customerPhone', 'items', 'subtotal', 'deliveryFee', 'total',
          'deliveryType', 'location', 'paymentMethod', 'changeFor', 'notes',
          'orderNumber', 'createdAt'
        ])
        && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 80
        && d.customerPhone is string && d.customerPhone.size() > 0 && d.customerPhone.size() <= 30
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 80
        && d.subtotal is number && d.subtotal >= 0 && d.subtotal <= 3000
        && d.deliveryFee is number && d.deliveryFee >= 0 && d.deliveryFee <= 100
        && d.total is number && d.total >= 0 && d.total <= 3100
        && math.abs(d.total - (d.subtotal + d.deliveryFee)) < 0.01
        && d.deliveryType in ['retirada', 'entrega']
        && d.location is string && d.location.size() <= 200
        && d.paymentMethod in ['pix', 'cartao', 'dinheiro']
        && d.changeFor is string && d.changeFor.size() <= 20
        && d.notes is string && d.notes.size() <= 300
        && d.orderNumber is int && d.orderNumber >= 1 && d.orderNumber <= 100
        && d.createdAt == request.time;
    }
  }
}
